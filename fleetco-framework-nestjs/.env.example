# All configuration from environment variables, twelve-factor, no exceptions
# (ADR-022 rule 2). Parsed and validated once in src/config.ts.

RUNTIME_ENV=development
PORT=3000

# Aurora Serverless v2 in production (ADR-023). The LISTEN connection needs a
# session-mode connection, not a transaction-mode pooler.
DATABASE_URL=postgres://fleetco:fleetco@127.0.0.1:5432/fleetco

OUTBOX_POLL_MS=200
OUTBOX_BATCH_SIZE=100
SSE_HEARTBEAT_MS=15000

# Sized against the load balancer's failureThreshold * periodSeconds, so the
# task is deregistered before it stops answering.
SHUTDOWN_READINESS_DELAY_MS=0

LOG_LEVEL=info
