{
  "name": "fleetco-framework-nestjs",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Framework spike 1 of 4 \u2014 the customers golden module on NestJS.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "node --watch -r ts-node/register src/main.ts",
    "migrate": "node -r ts-node/register scripts/migrate.ts",
    "openapi": "node -r ts-node/register scripts/openapi.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:leak": "vitest run --project leak",
    "test:all": "vitest run",
    "seed": "node -r ts-node/register scripts/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuidv7": "^1.0.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@swc/core": "^1.13.5",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "unplugin-swc": "^1.5.7",
    "vitest": "^3.2.4"
  }
}
