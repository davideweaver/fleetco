# ADR-022 rule 2: all configuration from environment variables, no exceptions.
RUNTIME_ENV=development
PORT=3000
LOG_LEVEL=info

# Aurora Serverless v2 in production (ADR-023). The SSE listener needs a direct
# session-mode connection, never a transaction-mode pooler.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleetco

# Outbox dispatcher (Realtime and Events § Dispatcher Mechanics).
OUTBOX_POLL_MS=200
OUTBOX_BATCH_SIZE=100

# SSE. The tick is the belt-and-braces catch-up when a NOTIFY is missed; the
# heartbeat keeps proxies from closing an idle stream.
SSE_TICK_MS=1000
SSE_HEARTBEAT_MS=15000

# ADR-022 rule 7: stop passing readiness checks before refusing connections.
SHUTDOWN_READINESS_DELAY_MS=0
