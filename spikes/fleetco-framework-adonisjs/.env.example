NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_KEY=

# session-mode connection required: the outbox listener issues LISTEN on it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fleetco
DATABASE_POOL_MAX=10

OUTBOX_POLL_MS=200
OUTBOX_BATCH_SIZE=100

SSE_TICK_MS=1000
SSE_HEARTBEAT_MS=15000

SHUTDOWN_READINESS_DELAY_MS=0
