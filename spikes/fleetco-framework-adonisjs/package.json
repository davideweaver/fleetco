{
  "name": "fleetco-framework-adonisjs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Framework spike 3 of 4 — the customers golden module on AdonisJS 6, with Drizzle, Zod and Vitest in place of Lucid, VineJS and Japa.",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node bin/server.js",
    "dev": "tsx watch bin/server.ts",
    "migrate": "tsx scripts/migrate.ts",
    "openapi": "tsx scripts/openapi.ts",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:leak": "vitest run --project leak",
    "test:all": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:leak"
  },
  "dependencies": {
    "@adonisjs/core": "^6.21.0",
    "drizzle-orm": "^0.44.5",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@testcontainers/postgresql": "^11.7.1",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "eslint": "^9.37.0",
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
