# RUNTIME_ENV=integration. DATABASE_URL is injected by the Testcontainers
# global setup, so it is deliberately absent here.
LOG_LEVEL=error
LOG_CONSOLE_FORMAT=json
PORT=0

# Effectively disables the background poll. The dispatcher's timer firing
# mid-assertion is the one source of flake in this suite — a test that asserts
# "not visible until dispatched" races a 50ms timer and loses occasionally. The
# tests call `dispatchOnce()` themselves instead, which makes every outbox
# assertion deterministic.
OUTBOX_POLL_INTERVAL_MS=600000

# Fast enough to assert within a test. The production default is 15s.
SSE_HEARTBEAT_MS=150
SSE_RETRY_MS=200
